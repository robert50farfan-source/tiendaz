NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx
# Solo para los scripts de scripts/; nunca cargarla en producción ni exponerla al cliente
SUPABASE_SERVICE_ROLE_KEY=xxxxx
# Asistente de compra con IA (solo servidor; sin esta clave el catálogo no muestra el asistente)
ANTHROPIC_API_KEY=sk-ant-xxxxx
# Opcionales: límites de uso del asistente
# ASSISTANT_LIMIT_PER_IP_HOUR=20
# ASSISTANT_LIMIT_PER_DAY=300
# Opcional: dominio para links absolutos (por defecto https://tiendaz.online)
# SITE_URL=https://tiendaz.online
